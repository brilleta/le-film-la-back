<?xml version="1.0" encoding="UTF-8"?>
<!--
  Console : format Spring Boot habituel (traceId/spanId inclus).
  OTEL : chaque log part aussi vers le SDK OpenTelemetry (installé par ObservabilityConfig), qui l'exporte en OTLP
  si un endpoint de logs est configuré. Le contexte de trace est attaché à l'enregistrement, pas au texte.
-->
<configuration>
	<include resource="org/springframework/boot/logging/logback/defaults.xml"/>
	<include resource="org/springframework/boot/logging/logback/console-appender.xml"/>

	<appender name="OTEL" class="io.opentelemetry.instrumentation.logback.appender.v1_0.OpenTelemetryAppender">
		<captureCodeAttributes>false</captureCodeAttributes>
	</appender>

	<root level="INFO">
		<appender-ref ref="CONSOLE"/>
		<appender-ref ref="OTEL"/>
	</root>
</configuration>
