ANTHROPIC_API_KEY=
TMDB_TOKEN=
# Optionnel, défaut : claude-haiku-5-5
ANTHROPIC_MODEL=claude-haiku-5-5

# Base PostgreSQL (docker compose remplace DB_URL par l'hôte du conteneur)
# Neon (prod Render) : jdbc:postgresql://ep-xxx.eu-central-1.aws.neon.tech/<db>?sslmode=require (endpoint direct, sans -pooler)
DB_URL=jdbc:postgresql://localhost:5432/lefilmla
DB_USERNAME=lefilmla
DB_PASSWORD=

# Clé de signature des JWT : base64, 32 octets minimum (ex. : openssl rand -base64 32)
JWT_SECRET=
# Optionnel, défaut : PT24H (format ISO-8601)
JWT_TTL=PT24H
# Optionnel, défaut : true. Mettre false uniquement en dev local en HTTP
AUTH_COOKIE_SECURE=true

# Optionnel : email du premier admin, promu au démarrage uniquement si aucun admin n'existe encore
# (le compte doit avoir été créé avant ; redémarrer après l'inscription)
ADMIN_EMAIL=

# Kafka : docker compose expose le broker sur localhost:9094 (dans le réseau compose : kafka:9092)
KAFKA_BOOTSTRAP_SERVERS=localhost:9094
# Optionnels : réglages des topics créés au démarrage (réplication = nombre de brokers)
KAFKA_TOPIC_PARTITIONS=3
KAFKA_TOPIC_REPLICATION_FACTOR=1

# Prod uniquement (SPRING_PROFILES_ACTIVE=prod, Aiven en SASL_SSL) : inutiles en local
# KAFKA_USERNAME=
# KAFKA_PASSWORD=
# KAFKA_CA_CERT=-----BEGIN CERTIFICATE-----\n…\n-----END CERTIFICATE-----
