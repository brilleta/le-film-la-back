ANTHROPIC_API_KEY=
TMDB_TOKEN=
# Optionnel, défaut : claude-haiku-5-5
ANTHROPIC_MODEL=claude-haiku-5-5

# Base PostgreSQL (docker compose remplace DB_URL par l'hôte du conteneur)
DB_URL=jdbc:postgresql://localhost:5432/lefilmla
DB_USERNAME=lefilmla
DB_PASSWORD=

# Clé de signature des JWT : base64, 32 octets minimum (ex. : openssl rand -base64 32)
JWT_SECRET=
# Optionnel, défaut : PT24H (format ISO-8601)
JWT_TTL=PT24H
# Optionnel, défaut : true. Mettre false uniquement en dev local en HTTP
AUTH_COOKIE_SECURE=true
